<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="app.aaps.weardata.permission" />

    <!-- Health Connect: read steps / heart rate as a fallback source for the overview graph -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <permission
        android:name="app.aaps.weardata.permission"
        android:label="AAPS WEAR DATA"
        android:protectionLevel="signature" />

    <!-- Allow detecting / launching the Health Connect app and handling its rationale intent -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application>

        <service
            android:name=".nsclient.services.NSClientService"
            android:enabled="true"
            android:exported="false" />
        <service
            android:name=".nsclientV3.services.NSClientV3Service"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".openhumans.ui.OHLoginActivity"
            android:exported="true"
            android:label="Setup Open Humans"
            android:launchMode="singleTop"
            android:theme="@style/OpenHumans">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="setup-openhumans"
                    android:scheme="androidaps" />
            </intent-filter>
        </activity>

        <receiver
            android:name="app.aaps.plugins.sync.wear.receivers.WearDataReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="app.aaps.weardata.permission">
            <intent-filter>
                <!-- Receiver from aapsclient -->
                <action android:name="app.aaps.aapsclient.weardata" />
            </intent-filter>
        </receiver>

        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!--  Setting host bellow prevents callback because of missing /.well-known/assetlinks.json                  android:host=""-->
                <data
                    android:path="/callback/tidepool"
                    android:scheme="aaps"
                    tools:ignore="AppLinkUrlError" />
            </intent-filter>
        </activity>
        <activity
            android:name="app.aaps.plugins.sync.tidepool.auth.AuthFlowIn"
            android:exported="true" />

        <!-- Health Connect permission rationale / grant entry point (also reachable from the
             Health Connect app). Required so the user can grant the steps / heart rate read
             permissions used by MetricsSamplerImpl. -->
        <activity
            android:name=".metrics.HealthConnectPermissionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".metrics.ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".metrics.HealthConnectPermissionActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>