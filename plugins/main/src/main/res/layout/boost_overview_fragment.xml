<?xml version="1.0" encoding="utf-8"?>
<!--
    boost_overview_fragment.xml — Redesigned Boost Overview home screen.
    All colours use theme attributes — no hardcoded dark values.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/boost_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Notifications -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ═══ Top section: Pump | BG Bobble | Connection ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <!-- Pump info column -->
                <LinearLayout
                    android:id="@+id/pump_section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:focusable="true"
                    android:importantForAccessibility="yes">

                    <!-- BG-quality warning triangle (yellow/red/hidden) — sits above PUMP -->
                    <ImageView
                        android:id="@+id/bg_quality"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_horizontal"
                        android:visibility="gone"
                        android:contentDescription="@string/a11y_bg_quality"
                        android:importantForAccessibility="no"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/pump_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PUMP"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorTertiary"
                        android:letterSpacing="0.05"
                        android:importantForAccessibility="no"
                        tools:ignore="HardcodedText" />
                    <TextView
                        android:id="@+id/pump_reservoir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:importantForAccessibility="no"
                        tools:text="87U" />
                    <TextView
                        android:id="@+id/pump_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:importantForAccessibility="no"
                        tools:text="🔋 72%" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:importantForAccessibility="no">
                        <TextView
                            android:id="@+id/pump_cannula_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:importantForAccessibility="no"
                            tools:text="🩹 1d 4h" />
                        <TextView
                            android:id="@+id/pump_sensor_age"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:importantForAccessibility="no"
                            tools:text="📡 4d 2h" />
                    </LinearLayout>
                </LinearLayout>

                <!-- BG Bobble -->
                <app.aaps.plugins.main.general.overview.boost.BgBobbleView
                    android:id="@+id/bg_bobble"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center" />

                <!-- Connection / Loop status column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/connection_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/openloop"
                        tools:ignore="ContentDescription" />
                    <TextView
                        android:id="@+id/loop_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:visibility="gone"
                        tools:text="30m" />

                    <!-- TBR (temporary basal rate) indicator — icon matches old UI, sized as loop icon -->
                    <LinearLayout
                        android:id="@+id/tbr_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <ImageView
                            android:id="@+id/tbr_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/basal"
                            app:srcCompat="@drawable/ic_cp_basal_no_tbr"
                            tools:ignore="ContentDescription" />
                        <TextView
                            android:id="@+id/tbr_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginStart="2dp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="120%" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/time_ago"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="4dp"
                        tools:text="2m ago" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Delta row (shows "a: x.x" acceleration in AutoISF mode) ═══ -->
            <TextView
                android:id="@+id/delta_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingBottom="8dp"
                tools:text="-0.8 mg/dL · Falling slowly" />

            <!-- ═══ First detail panel row: IOB | COB | TARGET | PROFILE ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- IOB panel -->
                    <LinearLayout
                        android:id="@+id/panel_iob"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="10dp"
                        android:minHeight="48dp"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IOB"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/panel_iob_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="3.21u" />
                    </LinearLayout>

                    <!-- COB panel -->
                    <LinearLayout
                        android:id="@+id/panel_cob"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="10dp"
                        android:minHeight="48dp"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COB"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/panel_cob_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="25g" />
                    </LinearLayout>

                    <!-- Target panel -->
                    <LinearLayout
                        android:id="@+id/panel_target"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="10dp"
                        android:minHeight="48dp"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TARGET"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/panel_target_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="5.5" />
                    </LinearLayout>

                    <!-- Profile panel -->
                    <LinearLayout
                        android:id="@+id/panel_profile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="10dp"
                        android:minHeight="48dp"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROFILE"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/panel_profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Default" />
                        <TextView
                            android:id="@+id/panel_profile_pct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="100%" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ Second detail panel row (standard): BOOST | TDD | DynISF | EXERCISE ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/row2_standard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center_horizontal">

                    <!-- Boost tier panel -->
                    <LinearLayout
                        android:id="@+id/panel_boost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="10dp"
                        android:minHeight="48dp"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BOOST"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/panel_boost_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Percent Scale" />
                        <TextView
                            android:id="@+id/panel_boost_fast_carb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFFF9800"
                            android:text="Fast Carb"
                            android:visibility="gone"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <!-- TDD panel -->
                    <LinearLayout
                        android:id="@+id/panel_tdd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="10dp"
                        android:minHeight="48dp"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TDD"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/panel_tdd_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="48.3" />
                    </LinearLayout>

                    <!-- DynISF panel -->
                    <LinearLayout
                        android:id="@+id/panel_dynisf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="10dp"
                        android:minHeight="48dp"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DynISF/CR"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/panel_dynisf_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="start"
                            tools:text="ISF 7.1\nCR 10.0" />
                    </LinearLayout>

                    <!-- Activity / Exercise mode panel -->
                    <LinearLayout
                        android:id="@+id/panel_activity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="10dp"
                        android:minHeight="48dp"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXERCISE"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/panel_activity_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            tools:text="Inactive" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ Boost V6 decision strip (shown only when Boost V6 is the active APS) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/v5_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:foreground="?attr/selectableItemBackground"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- Row 1: state · action multiplier · age, then dose / budget -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/v5_state"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            tools:text="CONFIRMED  ×1.8 · 2c" />

                        <TextView
                            android:id="@+id/v5_dose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:gravity="end"
                            android:textColor="?android:attr/textColorSecondary"
                            tools:text="dose 0.45U · budget 0.78U" />
                    </LinearLayout>

                    <!-- Row 2: meal score gauge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCORE"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            android:layout_marginEnd="8dp"
                            tools:ignore="HardcodedText" />

                        <ProgressBar
                            android:id="@+id/v5_score_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_weight="1"
                            android:max="100"
                            tools:progress="62" />

                        <TextView
                            android:id="@+id/v5_score_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"
                            android:minWidth="36dp"
                            android:gravity="end"
                            tools:text="0.62" />
                    </LinearLayout>

                    <!-- Row 3: active brakes (hidden when none) -->
                    <TextView
                        android:id="@+id/v5_brakes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="⛔ min_guard_bg · iob 0.85 · decel 0.50" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ Second detail panel row (AutoISF): Deltas | ISF | AutoISF factors | (reserved) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/row2_autoisf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Block 1: BG deltas (current / 15m / 40m) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="8dp"
                        android:minHeight="48dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DELTA"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/autoisf_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Δ +0.3" />
                        <TextView
                            android:id="@+id/autoisf_avg_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            tools:text="Δ15 +0.2" />
                        <TextView
                            android:id="@+id/autoisf_long_avg_delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            tools:text="Δ40 +0.1" />
                    </LinearLayout>

                    <!-- Block 2: ISF profile / calculated + carb ratio -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="8dp"
                        android:minHeight="48dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ISF/CR"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />
                        <TextView
                            android:id="@+id/autoisf_isf_profile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            tools:text="ISFp 2.9" />
                        <TextView
                            android:id="@+id/autoisf_isf_calc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="ISFc 3.4" />
                        <TextView
                            android:id="@+id/autoisf_isf_carbs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            tools:text="CR 10.0" />
                    </LinearLayout>

                    <!-- Block 3 (+ old Block 4): AutoISF intermediate factors — spans 2 columns,
                         tap to open the APS "Result" block (Script debug / Result / Request) -->
                    <LinearLayout
                        android:id="@+id/panel_autoisf_factors"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="8dp"
                        android:minHeight="48dp"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FACTORS"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorTertiary"
                            android:letterSpacing="0.1"
                            tools:ignore="HardcodedText" />

                        <!-- Two columns: Accel/BG/PP | Dura/Final -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:layout_marginEnd="12dp">
                                <TextView
                                    android:id="@+id/autoisf_acce"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    tools:text="Accel 1.05" />
                                <TextView
                                    android:id="@+id/autoisf_bg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    tools:text="BG 1.00" />
                                <TextView
                                    android:id="@+id/autoisf_pp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    tools:text="PP 1.00" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">
                                <TextView
                                    android:id="@+id/autoisf_dura"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    tools:text="Dura 1.00" />
                                <TextView
                                    android:id="@+id/autoisf_final"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="Final 1.05" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ BG Graph (reuses existing) ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/graphCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ═══ Primary BG graph ═══ -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.jjoe64.graphview.GraphView
                            android:id="@+id/bg_graph"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:contentDescription="@string/a11y_graph" />

                        <Button
                            android:id="@+id/scale_button"
                            android:layout_width="65dp"
                            android:layout_height="35dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginStart="35dp"
                            android:contentDescription="@string/a11y_graph_scale"
                            android:drawableEnd="@drawable/ic_arrow_drop_down_white_24dp"
                            android:padding="0dp"
                            android:textAllCaps="false" />

                        <ImageButton
                            android:id="@+id/chart_menu_button"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="@string/chart_menu"
                            android:paddingTop="5dp"
                            app:srcCompat="@drawable/ic_arrow_drop_down_white_24dp" />

                    </RelativeLayout>

                    <!-- Thin divider between graphs -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="?android:attr/listDivider" />

                    <!-- ═══ Secondary graphs (dynamically built from chart menu) ═══ -->
                    <LinearLayout
                        android:id="@+id/secondary_graphs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Action buttons come from the standard overview_buttons_layout include below -->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══ Pump status bar ═══ -->
    <LinearLayout
        android:id="@+id/pump_status_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/pump_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="?attr/pumpStatusBackground"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>

    <!-- ═══ Progress bar ═══ -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:max="100"
        android:progress="100"
        android:indeterminate="false" />

    <!-- ═══ Action buttons (included from standard layout) ═══ -->
    <include
        android:id="@+id/buttons_layout"
        layout="@layout/overview_buttons_layout" />

</LinearLayout>
